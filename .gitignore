###############################################################################
# System & Editor Files
###############################################################################
# macOS system files
.DS_Store
.DS_Store?
._*

# VS Code workspace settings
.vscode/

# Editor swap/backup files
*.swp
*.swo
*~

###############################################################################
# Virtual Environments & Python Caches
###############################################################################
# Virtual environments (any project: venv_DSM, venv_enceladus, venv_pf311, ...)
.venv/
venv/
venv_*/
env/

# Python bytecode and cache
__pycache__/
*.py[cod]

# Jupyter notebook checkpoints
.ipynb_checkpoints/

###############################################################################
# PetIGA Upstream Directories (anchored to the repo root so they do not
# swallow same-named subdirectories inside projects/, e.g. projects/*/test/)
###############################################################################
/Original/
/input/
/test/

###############################################################################
# Image Files
###############################################################################
# Blanket rule: figures are regenerable from postprocess scripts. Individual
# projects re-include curated figures with a negation in their own .gitignore
# (see projects/enceladus_DSM/.gitignore).
*.png

