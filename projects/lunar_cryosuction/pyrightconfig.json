{
  "//": "Pyright (pyright-lsp plugin, CLI: pyright). Imports resolve against venv_cryosuction. Excludes match ruff.toml. paraview (pvpython only) stays unresolved by design.",
  "venvPath": ".",
  "venv": "venv_cryosuction",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportOptionalSubscript": "warning",
  "reportOptionalMemberAccess": "warning",
  "reportOptionalOperand": "warning",
  "reportOptionalIterable": "warning",
  "reportOptionalCall": "warning",
  "exclude": [
    "**/__pycache__",
    "venv_*",
    "scratch",
    "**/scratch",
    "studies/*/campaign_*",
    "preprocess/igakit_complexgeocodes"
  ],
  "executionEnvironments": [
    {
      "root": "scripts",
      "extraPaths": [
        "."
      ]
    },
    {
      "root": "studies",
      "extraPaths": [
        ".",
        "postprocess"
      ]
    },
    {
      "root": "."
    }
  ]
}
