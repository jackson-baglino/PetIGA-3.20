{
  "//": "Pyright (pyright-lsp plugin, CLI: pyright). Imports resolve against venv_lunar; scripts/ also sees venv_workflows. Excludes match ruff.toml. paraview (pvpython only) and mineru (venv_docparse) stay unresolved by design.",
  "venvPath": ".",
  "venv": "venv_lunar",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportOptionalSubscript": "warning",
  "reportOptionalMemberAccess": "warning",
  "reportOptionalOperand": "warning",
  "reportOptionalIterable": "warning",
  "reportOptionalCall": "warning",
  "exclude": [
    "**/__pycache__",
    "venv_*",
    "scratch",
    "**/scratch",
    "library",
    "library_practice",
    "index",
    "runs",
    "studies/*/campaign_*",
    "test",
    "preprocess/igakit_complexgeocodes"
  ],
  "executionEnvironments": [
    { "root": "scripts", "extraPaths": [".", "scripts/units_verification", "venv_workflows/lib/python3.11/site-packages"] },
    { "root": "studies", "extraPaths": [".", "postprocess"] },
    { "root": "." }
  ]
}
