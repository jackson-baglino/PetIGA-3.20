# =============================================================================
# experiment/heatflux/hf_twall_linear_air.opts
# =============================================================================
# Test c2: T_w = T_init + dT (1 - x/L), L = Lx = 200 um, on all four faces
# (x0: T_init + dT, x1: T_init). The steady field is the same linear profile,
# which lies in the p = 2 space; a consistent (Nitsche) imposition makes the
# discrete steady state exact.
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0
-resolution_check 0
-outp 0
-pf_output 1
-Twall_faces x0,x1,y0,y1
-Twall_profile linear
-Twall_axis 0
-Twall_s0 0.0
-Twall_length 2.0e-4
-Twall_dT 2.0
-t_final 0.1
-t_interv 0.02
-delt_t 1.0e-6
-dtmax 2.0e-3
