# =============================================================================
# experiment/heatflux/hf_slab_q100_air.opts
# =============================================================================
# Tests b, d (air): q = 100 W/m2 into x0 of a 600 um air slab, every other
# face insulated. Semi-infinite solution T(0,t) - T0 = (2q/k) sqrt(alpha t/pi)
# holds while sqrt(alpha t) << L: at t = 2 ms sqrt(alpha t) = 169 um, and the
# reflection from x = L changes T(0,t) by 4 (q/k) sqrt(alpha t) ierfc(L/sqrt(alpha t))
# < 1e-6 of the rise.
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0
-resolution_check 0
-outp 0
-pf_output 1
-qflux_faces x0
-qflux 100.0
-t_final 2.0e-3
-t_interv 2.5e-4
-delt_t 1.0e-7
-dtmax 2.0e-6
