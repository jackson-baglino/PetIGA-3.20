# =============================================================================
# experiment/heatflux/hf_steady_q100.opts
# =============================================================================
# Test a: steady 1D flux. q = 100 W/m2 into x0, T pinned to -temp on x1
# (strong Dirichlet), y faces insulated. Steady T is linear with slope -q/k,
# which lies in the p = 2 spline space, so the discrete steady state is exact.
# t_final = 0.1 s is about 36 L^2/alpha (air, L = 200 um): the slowest mode
# exp(-pi^2 alpha t / (4 L^2)) is below 1e-30.
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0
-resolution_check 0
-outp 0
-pf_output 1
-qflux_faces x0
-qflux 100.0
-flag_BC_Tfix 1
-Tfix_faces x1
-t_final 0.1
-t_interv 0.02
-delt_t 1.0e-6
-dtmax 2.0e-3
