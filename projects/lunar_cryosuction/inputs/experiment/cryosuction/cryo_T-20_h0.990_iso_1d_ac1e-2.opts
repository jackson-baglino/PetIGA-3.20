# experiment/cryosuction/cryo_T-20_h0.990_iso_1d_ac1e-2.opts
#
# Plan issue 1 (eps convergence, 2026-11-06): cryo_T-20_h0.990_iso_5d_ac1e-2
# cut to 1 day, which covers the narrow-plug phase of 0c-C1 (it vanished at
# 5.3-6.0e4 s). Only -t_final and -n_out differ from the 5-day file; the
# 0.86 um member of the pair is 0c-C1 itself, compared over its first day.
#
#
# Stage 0, pilot C: open end x = 0 at h = 0.990, dead pore at x = Lx, isothermal
# bath on every face (T fixed at both ends and on the walls). h = 0.998 is for
# the regolith pore, whose eps budget does not allow h = 0.99 (see its file).
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0,0.0
-flag_BC_Tfix 1
-flag_BC_rhovfix 1
-rhovfix_faces x0
-phi_open_bc 0                          # x0 is a 90-degree face for phi (natural BC). The default
                                        # do-nothing "open" phi condition is ill-posed: ice that
                                        # touches it spreads into a flat film (stage-0b A1/A4, BC
                                        # review 2026-11-05). Decided by the user 2026-11-05.
-rhovfix_lo 0.990
-t_final 8.64e4
-n_out 49                               # every 30 min: vanishing time to 0.5 h
# --- substrate and kinetics ---
-beta_sub0 7.9408e5                     # K&P beta0 at -20 C, alpha_c = 1e-2 (comp_eps beta_sub)
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
# -dtmax is in the GEOMETRY file: 2*tau_sub depends on that geometry's eps.
-dtCFL 1
-outp 0
