# experiment/cryosuction/cryo_T-20_h0.900_G+1000_warmdead_5d.opts
#
# Stage 0, pilot C3: as cryo_T-20_h0.900_iso_5d.opts but with a gradient along
# the channel, the DEAD end warm: +1000 K/m, so over the 850 um two-throat
# channel T runs from -20.425 C (open end) to -19.575 C (dead end). T fixed at
# both ends; walls (parallel to the gradient) insulated. Warm dead end drives
# vapor toward the cold open end, the case where ice could redeposit near the
# outlet. rhovfix_lo is a multiple of rho_vs(temp0 = -20 C), not of the local
# rho_vs(-20.425 C): h_local = 0.90*rho_vs(-20)/rho_vs(-20.425) = 0.938.
-temp -20.0
-humidity 1.0
-grad_temp0 1000.0,0.0,0.0
-flag_BC_Tfix 1
-Tfix_faces x0,x1
-flag_BC_rhovfix 1
-rhovfix_faces x0
-rhovfix_lo 0.900
-t_final 4.32e5
-n_out 19
# --- substrate and kinetics: as the velocity study (studies/contact_angle) ---
-beta_sub0 7.9408e6                     # K&P beta0 at -20 C, alpha_c = 1e-3
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
-dtmax 1.17e4                           # 2*tau_sub, tau_sub = 5.8604e3 s (printed by the solver)
-dtCFL 1
-dtCFL_dphimax 0.2
-outp 0
