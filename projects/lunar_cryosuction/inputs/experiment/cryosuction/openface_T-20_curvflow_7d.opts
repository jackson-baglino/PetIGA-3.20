# experiment/cryosuction/openface_T-20_curvflow_7d.opts
#
# Stage 0, tests A1/A3/A4: pure curvature flow (-decouple_phase_change 1) with
# x = 0 open. The vapor reservoir on x0 exists only to make the face open (the
# solver opens phi on vapor-Dirichlet faces that are not walls); with the
# phase-change coupling off, vapor and T do not act on the ice.
# D = eps^2/tau_sub = 1.257e-16 m^2/s. t_final 6.0e5 s: the A3 disc shrinks
# to R = 7.0 um (vanishes at R0^2/(2D) = 8.9e5 s); the A1 visible part is
# gone once R < 7.5 um (6.7e5 s).
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0,0.0
-flag_BC_Tfix 1
-flag_BC_rhovfix 1
-rhovfix_faces x0
-rhovfix_lo 1.0
-decouple_phase_change 1
-phi_open_bc 1
-t_final 6.0e5
-n_out 25
# --- substrate and kinetics: as the velocity study (studies/contact_angle) ---
-beta_sub0 7.9408e6                     # K&P beta0 at -20 C, alpha_c = 1e-3
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
-dtmax 1.17e4                           # 2*tau_sub, tau_sub = 5.8604e3 s (printed by the solver)
-dtCFL 1
-dtCFL_dphimax 0.2
-outp 0
