# experiment/cryosuction/cryo_T-20_h0.900_insdead_5d.opts
#
# Stage 0, pilot C4: as cryo_T-20_h0.900_iso_5d.opts but T is fixed ONLY at the
# open end; the dead pore and the walls are insulated. Compared with C1 this
# isolates the latent-heat (sublimation cooling) effect of the thermal BC.
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0,0.0
-flag_BC_Tfix 1
-Tfix_faces x0
-flag_BC_rhovfix 1
-rhovfix_faces x0
-rhovfix_lo 0.900
-t_final 4.32e5
-n_out 19
# --- substrate and kinetics: as the velocity study (studies/contact_angle) ---
-beta_sub0 7.9408e6                     # K&P beta0 at -20 C, alpha_c = 1e-3
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
-dtmax 1.17e4                           # 2*tau_sub, tau_sub = 5.8604e3 s (printed by the solver)
-dtCFL 1
-dtCFL_dphimax 0.2
-outp 0
