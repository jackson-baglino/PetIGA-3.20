# experiment/cryosuction/t7s_T-20_hsat_G20warmcollector_wallT_theta60_120d_n401_ac1e-2.opts   (make_type7_inputs.py, 2026-11-17)
#
# Plan type 7S (saturated, user 2026-11-17): G = 20 K/m, warm end at the collector (x = 0). Vapor saturated at start; the collector
# holds the saturation density of its own temperature (-19.982000 C); T fixed on both ends and
# on the walls (linear wall profile from -19.982000 C at x = 0 m to -20.018000 C).
# -dtmax is in the GEOMETRY file (2 tau_sub at its eps).
#
-grad_temp0 -20.0,0.0,0.0
-flag_BC_Tfix 1
-Tfix_faces x0,x1                        # ends at the IC values
-Twall_faces y0,y1                       # walls: T_w = T_init + dT (1 - |x - s0| / L), Nitsche
-Twall_profile linear
-Twall_axis 0
-Twall_s0 0.000000e+00
-Twall_length 1.800000e-03
-Twall_dT 3.600000e-02                    # G Lx
-Twall_Tinit -20.0180000000             # cold end
-temp -20.0
-humidity 1.0
-flag_BC_rhovfix 1
-rhovfix_faces x0
-rhovfix_lo 1.0017303748                 # rho_vs(-19.982000 C) / rho_vs(-20 C): saturated at the collector's own T (rhov_bc.py --T0 -20 --G -20 --Lx 0.0018 --local-sat)
-phi_open_bc 0                          # 90-degree phi face on the pore ends
-t_final 1.036800e+07                       # 120 days
-n_out 401                              # time-uniform snapshots
-beta_sub0 7.9408e5                     # K&P beta0 at -20 C, alpha_c = 1e-2
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
-dtCFL 1
-outp 0
-outp_dphi 0.5                          # extra snapshot when phi changed by 0.5 anywhere (e5a593e7)
-outp_dphi_min_dt 3600                  # at most one such snapshot an hour
