# experiment/cryosuction/t7_T-20_h0.990_iso_theta60_60d_ac1e-2.opts
#
# Plan type 7A (SimulationPlan_v2): regolith pore, isothermal reference harvest.
# Collector at x = 0 holds rho_v = 0.990 rho_vs(T0) (decision D2); the dead end
# x = Lx is sealed (zero vapor flux, 90-degree phi face); walls y0, y1 carry the
# contact-angle BC at 60 deg (D1). Isothermal bath on every face.
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0,0.0
-flag_BC_Tfix 1
-flag_BC_rhovfix 1
-rhovfix_faces x0
-rhovfix_lo 0.990
-phi_open_bc 0                          # 90-degree phi face on the pore ends (user, 2026-11-05)
-t_final 5.184e6                        # 60 days
-n_out 61                               # one snapshot a day
# --- substrate and kinetics ---
-beta_sub0 7.9408e5                     # K&P beta0 at -20 C, alpha_c = 1e-2 (comp_eps beta_sub)
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
# -dtmax is in the GEOMETRY file: 2*tau_sub depends on that geometry's eps.
-dtCFL 1
-outp 0
