# experiment/cryosuction/t5_T-20_G1warmtop_ls_theta60_120d_ac1e-2.opts   (make_type125_inputs.py, 2026-11-09)
#
# Plan 5A/5C: local-saturation pair at G = 1 K/m.
# Thermal: gradient 1 K/m, warm top (x = 0), T fixed on x0 and x1, other faces insulating. Vapor set "ls". Wall angle theta = 60 deg (D1) from
# Young (gamma_is = 0.3 - 0.109 cos theta). 120 days, 1 snapshot(s) a day.
# -dtmax is in the GEOMETRY file (2 tau_sub depends on its eps).
#
-temp -20.0
-humidity 1.0
-grad_temp0 -1,0.0,0.0
-flag_BC_Tfix 1
-Tfix_faces x0,x1
-flag_BC_rhovfix 1
-rhovfix_faces x0,x1
-rhovfix_lo 1.0000384229                 # rho_vs(-19.9996 C) / rho_vs(-20 C)
-rhovfix_hi 0.9999615784                 # rho_vs(-20.0004 C) / rho_vs(-20 C)
-phi_open_bc 0                          # 90-degree phi face on every non-wall face
-t_final 1.036800e+07
-n_out 121
-beta_sub0 7.9408e+05                     # K&P beta0 at -20 C, alpha_c = 1e-2
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # cos(theta) = +0.500000
-dtCFL 1
-outp 0
