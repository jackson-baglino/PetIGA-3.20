# experiment/cryosuction/t3top_T-20_theta120_120d_ac1e-2.opts   (make_type34_inputs.py, 2026-11-07)
#
# Plan type 3D: supply at x0 only, x1 closed; the lens should migrate.
# Isothermal at -20 C (T fixed on the boundary), theta = 120 deg from Young
# (gamma_is = 0.3 - 0.109 cos theta), vapor set "top", 120 days.
# -dtmax is in the GEOMETRY file (2 tau_sub depends on its eps).
#
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0,0.0
-flag_BC_Tfix 1
-flag_BC_rhovfix 1
-rhovfix_faces x0                       # supply at x0 only; x1 zero flux
-rhovfix_lo 1.000000
-phi_open_bc 0                          # 90-degree phi face on every non-wall face
-t_final 1.036800e+07
-n_out 121                              # one snapshot a day
-beta_sub0 7.9408e+05                     # K&P beta0 at -20 C, alpha_c = 1e-2
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.3545000                     # cos(theta) = -0.500000
-dtCFL 1
-outp 0
