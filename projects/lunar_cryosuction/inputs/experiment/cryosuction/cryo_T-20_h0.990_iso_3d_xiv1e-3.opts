# experiment/cryosuction/cryo_T-20_h0.990_iso_3d_xiv1e-3.opts
#
# Stage 0, test B (time-scaling invariance): open end x = 0 at h = 0.99 of
# rho_vs(T0), dead pore at x = Lx (zero vapor flux), isothermal bath on every
# face. Pore starts saturated (-humidity 1.0). Only -xi_v differs within the
# B set; Kaempfer and Plapp (2009, Sec. II D) predict the same ice evolution
# and the same physical outflow (bflux.dat) for any xi_v that keeps the run
# quasi-steady. Default xi_v is 1e-3.
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0,0.0
-flag_BC_Tfix 1
-flag_BC_rhovfix 1
-rhovfix_faces x0
-rhovfix_lo 0.990
-xi_v 1e-3
-t_final 2.592e5
-n_out 12
# --- substrate and kinetics: as the velocity study (studies/contact_angle) ---
-beta_sub0 7.9408e6                     # K&P beta0 at -20 C, alpha_c = 1e-3
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
-dtmax 1.17e4                           # 2*tau_sub, tau_sub = 5.8604e3 s (printed by the solver)
-dtCFL 1
-dtCFL_dphimax 0.2
-outp 0
