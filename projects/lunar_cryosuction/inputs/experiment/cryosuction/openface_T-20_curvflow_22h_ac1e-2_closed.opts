# experiment/cryosuction/openface_T-20_curvflow_22h_ac1e-2_closed.opts
#
# Stage 0, test A2: as openface_T-20_curvflow_22h_ac1e-2.opts but
# -phi_open_bc 0 (x = 0 is a 90 deg Neumann face): the control.
-temp -20.0
-humidity 1.0
-grad_temp0 0.0,0.0,0.0
-flag_BC_Tfix 1
-flag_BC_rhovfix 1
-rhovfix_faces x0
-rhovfix_lo 1.0
-decouple_phase_change 1
-phi_open_bc 0
-t_final 8.0e4
-n_out 41
# --- substrate and kinetics ---
-beta_sub0 7.9408e5                     # K&P beta0 at -20 C, alpha_c = 1e-2 (comp_eps beta_sub)
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # Young: cos(theta) = 0.5, theta = 60 deg
# -dtmax is in the GEOMETRY file: 2*tau_sub depends on that geometry's eps.
-dtCFL 1
-dtCFL_dphimax 0.2
-outp 0
