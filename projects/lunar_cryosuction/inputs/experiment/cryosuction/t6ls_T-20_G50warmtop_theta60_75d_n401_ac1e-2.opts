# experiment/cryosuction/t6ls_T-20_G50warmtop_theta60_75d_n401_ac1e-2.opts   (make_type6_inputs.py, 2026-11-12)
#
# Plan type 6C (RunPlan_2026-11-12): lens through a neck, G = 50 K/m.
# Gradient G = 50 K/m along the pore, WARM at x = 0 (the top; depth is drawn
# downward): grad_temp0 = -50 K/m, so T(0) = -19.972500 C and T(Lx) = -20.027500 C
# for Lx = 1.1 mm. T is fixed on both ends; the walls are insulating.
# Vapor: local-saturation pair, each end at rho_vs of its own temperature
# (rhov_bc.py --T0 -20 --G -50 --Lx 0.0011 --local-sat). The values depend on Lx:
# use this file only with the 1.1 mm type-6 pores.
# theta = 60 deg from Young (gamma_is = 0.3 - 0.109 cos theta), 75 days.
# -dtmax is in the GEOMETRY file (2 tau_sub depends on its eps).
#
-temp -20.0
-humidity 1.0
-grad_temp0 -50.0,0.0,0.0
-flag_BC_Tfix 1
-Tfix_faces x0,x1
-flag_BC_rhovfix 1
-rhovfix_faces x0,x1
-rhovfix_lo 1.0026447365                 # rho_vs(-19.9725 C) / rho_vs(-20 C), warm end
-rhovfix_hi 0.9973616723                 # rho_vs(-20.0275 C) / rho_vs(-20 C), cold end
-phi_open_bc 0                          # 90-degree phi face on both pore ends
-t_final 6.480000e+06
-n_out 401                              # 5.33 snapshot(s) a day
-beta_sub0 7.9408e+05                     # K&P beta0 at -20 C, alpha_c = 1e-2
-gamma_ia 0.109
-gamma_as 0.3
-gamma_is 0.2455000                     # cos(theta) = +0.500000
-dtCFL 1
-outp 0
-outp_dphi 0.5                          # extra snapshot when phi changed by 0.5 anywhere (e5a593e7)
-outp_dphi_min_dt 3600                  # at most one such snapshot an hour
