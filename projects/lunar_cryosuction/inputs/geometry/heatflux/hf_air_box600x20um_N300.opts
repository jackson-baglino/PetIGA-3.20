# =============================================================================
# geometry/heatflux/hf_air_box600x20um_N300.opts
#
# Heat-flux / wall-temperature BC verification
# (studies/heatflux_bc/verification/): tests b, d (flux into an air slab), h = 2 um.
# Uniform phase (air), so no interface exists and phase change cannot
# confound the thermal check. eps is not used by a uniform field; it is set
# near h only so the start-up checks have a value.
# =============================================================================
-ic_type multi_grains
# Ice-free: one tiny grain 1 m outside the box. 0.5 - 0.5 tanh(huge) is
# exactly 0 in double precision, so phi = 0 at every control point.
-ice_grain_cx -1.0
-ice_grain_cy -1.0
-ice_grain_R  1.0e-6
-dim 2
-Nz 1
-Lz 0
-eps 2.0e-6
-eps_valid_temp -20.0
-periodic 0
-Nx 300
-Ny 4
-Lx 6.0000e-04
-Ly 2.0000e-05
