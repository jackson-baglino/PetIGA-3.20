# =============================================================================
# geometry/cryosuction/channel_2D_H100um_L270um_eps0.86um_lens150.opts   (make_type34_inputs.py, 2026-11-07)
#
# Plan type 4A-0: flat 100 um pore, the omega = 0 reference for the wedges.
# Flat pore 270 x 100 um, walls y0 and y1. Lens = slab 60.0-210.0 um
# (150 um long, area 1.5000e-08 m^2) with flat faces (90 deg at t = 0): the
# intersection of two far, crossed discs (R = 6.250e-03 m, face sag 0.200 um), as in
# contactangle/channel_2D_H125um_eps0.86um_flat90.opts.
# eps 8.5840e-07 m (velocity-study value; see make_type34_inputs.py), h = eps/sqrt(2).
# dtmax = 2 tau_sub = 1.3412e+03 s.
# =============================================================================
-ic_type multi_grains
-dim 2
-Nx 445
-Ny 165
-Nz 1
-Lx 2.700000e-04
-Ly 1.000000e-04
-Lz 0
-bridge_cxL 6.310000e-03
-bridge_rL  6.250000e-03
-bridge_cxR -6.040000e-03
-bridge_rR  6.250000e-03
-bridge_cy  5.000000e-05
-eps 8.5840e-07
-eps_valid_temp -20
-delt_t 1.0e-4
-periodic 0
-wall_faces y0,y1
-dtmax 1.3412e+03
