-ice_grain_R  3.000000e-05,2.300000e-05,3.000000e-05,3.000000e-05,3.000000e-05,2.200000e-05,3.000000e-05,2.700000e-05,3.000000e-05,3.000000e-05,2.100000e-05,2.600000e-05
-ice_grain_ax 3.000000e-05,2.300000e-05,3.000000e-05,3.000000e-05,3.000000e-05,2.200000e-05,3.000000e-05,2.700000e-05,3.000000e-05,3.000000e-05,2.100000e-05,2.600000e-05
-ice_grain_ay 3.000000e-05,2.300000e-05,3.000000e-05,3.000000e-05,3.000000e-05,2.200000e-05,3.000000e-05,2.700000e-05,3.000000e-05,3.000000e-05,2.100000e-05,2.600000e-05
-delt_t 1.0e-4
-eps 8.5840e-07
-eps_valid_temp -20   # C: temperature eps/mesh were sized for; solver ABORTS if -temp differs (override: -eps_temp_override 1)
-periodic 0
