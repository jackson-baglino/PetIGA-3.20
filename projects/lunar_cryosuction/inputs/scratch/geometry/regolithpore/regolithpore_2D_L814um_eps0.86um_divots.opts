-ice_grain_cx 1.207602e-04,2.196914e-04,3.389962e-04,4.661935e-04,6.176189e-04,7.152653e-04,1.064436e-04,2.356599e-04,3.556989e-04,5.344726e-04,6.297329e-04,7.193033e-04
