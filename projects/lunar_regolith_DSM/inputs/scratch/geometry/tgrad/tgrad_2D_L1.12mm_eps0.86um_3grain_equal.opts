# =============================================================================
# geometry/2D_Tgrad_3grain_equal.opts — THREE EQUAL semicircular ice grains on
# the floor, equally spaced. Temperature-gradient sanity series (Effort 1).
# Pair with experiment/Tgrad_T-20_G50_3d.opts (dT/dx = -50 K/m, left warm).
#
# TEST 3 — three-grain gradient baseline. With three equal grains under the
# gradient, the warm (left) grain feeds the chain and the cold (right) grain is
# the ultimate sink; the middle grain is a way-station. Establishes the equal
# three-grain reference for tests 4 (small centre) and 5 (large centre).
#
# GEOMETRY (planar 2D, NOT axisymmetric)
# --------------------------------------
#   Lx = 1.125e-3 m (1.5x the two-grain width — "proportionally larger" for 3
#                    grains), Ly = 2.0e-4 m (reduced)
#   centres: x = 0.2 Lx, 0.5 Lx, 0.8 Lx = 2.25e-4, 5.625e-4, 9.00e-4;  y = 0
#   R = 5.0e-5 m each (50 um)
#   inter-grain surf gap = 4.75 R ;  outer wall clearance = 3.5 R
#     (grains a touch closer to the walls than to each other, as intended)
#
# eps / MESH  (comp_eps.py, T0 = -20 C, alpha_c = 1.341e-2; eps/R = 1.7%)
#     python preprocess/comp_eps.py --Lx 1.125e-3 --Ly 2.0e-4 --Rave 5.0e-5 \
#         --T0 -20 --alpha 1.341e-2
# =============================================================================

-axisym 0

-ic_type multi_grains
-dim 2
-Lx 1.1250e-03
-Ly 2.0000e-04
-Lz 0

-ice_grain_cx 2.2500e-04,5.6250e-04,9.0000e-04   # 0.2Lx, 0.5Lx, 0.8Lx
-ice_grain_cy 0.0,0.0,0.0                          # centres on the floor -> semicircles
-ice_grain_R  5.0e-5,5.0e-5,5.0e-5                  # equal, 50 um
-ice_grain_ax 5.0e-5,5.0e-5,5.0e-5
-ice_grain_ay 5.0e-5,5.0e-5,5.0e-5

-Nx 1854                                   # ceil(sqrt(2)*Lx/eps)
-Ny 330
-Nz 1
-eps 8.5840e-07

-delt_t 1.0e-4
-periodic 0
