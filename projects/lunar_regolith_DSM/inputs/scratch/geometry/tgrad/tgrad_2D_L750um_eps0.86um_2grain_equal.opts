# =============================================================================
# geometry/2D_Tgrad_2grain_equal.opts — two EQUAL semicircular ice grains on the
# floor, WELL SEPARATED. Temperature-gradient sanity series (Effort 1).
# Pair with experiment/Tgrad_T-20_G50_3d.opts (dT/dx = -50 K/m, left warm).
#
# TEST 1 — well-separated equal pair. Supersedes the prior two-grain run where
# the surface-to-surface gap was only 0.5 R and distorted the vapour pathway.
# Here the grains are HALF the size (50 um) and moved to Lx/4 & 3Lx/4, giving a
# 5.5 R gap. Expectation: the warm (left) grain sublimates and redeposits on the
# cold (right) grain (total ice conserved) — any asymmetry is unambiguously the
# gradient's doing, not proximity.
#
# GEOMETRY (planar 2D, NOT axisymmetric)
# --------------------------------------
#   Lx = 7.5e-4 m (same width as the prior batch), Ly = 2.0e-4 m (reduced)
#   centres: x = Lx/4 = 1.875e-4, x = 3Lx/4 = 5.625e-4;  both y = 0
#   R = 5.0e-5 m each (50 um)
#   surf-to-surf = Lx/2 - 2R = 2.75e-4 = 5.5 R ;  wall clearance = 2.75 R
#
# eps / MESH  (comp_eps.py, T0 = -20 C, alpha_c = 1.341e-2; eps/R = 1.7%)
#     python preprocess/comp_eps.py --Lx 7.5e-4 --Ly 2.0e-4 --Rave 5.0e-5 \
#         --T0 -20 --alpha 1.341e-2
# =============================================================================

-axisym 0

-ic_type multi_grains
-dim 2
-Lx 7.5000e-04
-Ly 2.0000e-04
-Lz 0

-ice_grain_cx 1.8750e-04,5.6250e-04       # Lx/4 and 3Lx/4
-ice_grain_cy 0.0,0.0                       # centres on the floor -> semicircles
-ice_grain_R  5.0e-5,5.0e-5                  # equal, 50 um
-ice_grain_ax 5.0e-5,5.0e-5
-ice_grain_ay 5.0e-5,5.0e-5

-Nx 1236                                   # ceil(sqrt(2)*Lx/eps)
-Ny 330
-Nz 1
-eps 8.5840e-07

-delt_t 1.0e-4
-periodic 0
