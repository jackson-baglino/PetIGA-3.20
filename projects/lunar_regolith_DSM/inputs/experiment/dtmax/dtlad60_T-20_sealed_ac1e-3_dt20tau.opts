# =============================================================================
# experiment/dtmax/dtlad60_T-20_sealed_ac1e-3_dt20tau.opts
#
# DTMAX LADDER, sealed two-grain cases: -dtmax = 20 x tau_sub
# (tau_sub = 5850 s at -20 C, alpha_c = 1e-3). Pair with
#   sinterpair_2D_L120um_eps0.86um   (sintering, then absorption)
#   ripenpair_2D_L132um_eps0.86um    (Ostwald ripening through the vapour)
#
# 60 days, sealed and isothermal: total ice is conserved, so the rungs are
# compared on the interface length written every step to SSA_evo.dat, and on
# WHEN the small grain disappears. The 2026-07-10 stress test is the reason
# this matters: with the CFL limiter on, a 12x larger dtmax stayed stable and
# ripple-free but put grain extinction 32 % late.
#
# 11 snapshots: dtmax must stay <= 0.5 * t_final/(n_out-1) = 44 x tau_sub.
# =============================================================================
-t_final 5.184e6

-temp -20.0
-humidity 1.00
-grad_temp0 0.0,0.0,0.0

-beta_sub0 7.9408e6                     # K&P beta0 at -20 C (alpha_c = 1e-3)
-d0_sub0 1.0166e-9                      # physical capillary length at -20 C

-dtmax 1.1699e+05
-dtCFL 1
-dtCFL_dphimax 0.2

-outp 0
-n_out 11
