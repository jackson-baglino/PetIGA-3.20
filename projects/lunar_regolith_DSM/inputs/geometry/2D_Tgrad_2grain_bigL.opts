# =============================================================================
# geometry/2D_Tgrad_2grain_bigL.opts — two unequal grains: BIG grain on the WARM
# (left) side. Temperature-gradient sanity series (Effort 1).
# Pair with experiment/Tgrad_T-20_G50_3d.opts (dT/dx = -50 K/m, left warm).
#
# TEST 2 — COMPETING drivers. The big (150 um) grain sits on the warm/left side,
# so the temperature gradient drives it to SUBLIMATE (shrink) while Ostwald
# ripening favours the big grain GROWING. The small (50 um) right grain is
# pushed the opposite way by each driver. This isolates gradient vs. ripening
# when they OPPOSE.
#
# GEOMETRY (planar 2D, NOT axisymmetric)
# --------------------------------------
#   Lx = 1.0e-3 m (widened from the 0.75 mm two-grain width so the 150 um grain
#                  keeps clean Lx/4, 3Lx/4 placement), Ly = 3.0e-4 m (headroom
#                  for the 150 um grain)
#   centres:  big  (left,  R = 1.5e-4): x = Lx/4  = 2.5e-4
#             small(right, R = 5.0e-5): x = 3Lx/4 = 7.5e-4;  both y = 0
#   clearances: big  -> 2 R_small (100 um) off the warm wall
#               small-> 4 R_small off the cold wall
#   surf-to-surf = 3.0e-4 = 6 R_small (non-touching; interface ~9 eps ~ 8 um)
#
# eps / MESH  (comp_eps.py, T0 = -20 C, alpha_c = 1.341e-2; eps/R_small = 1.7%)
#     python preprocess/comp_eps.py --Lx 1.0e-3 --Ly 3.0e-4 --Rave 5.0e-5 \
#         --T0 -20 --alpha 1.341e-2
# =============================================================================

-axisym 0

-ic_type multi_grains
-dim 2
-Lx 1.0000e-03
-Ly 3.0000e-04
-Lz 0

-ice_grain_cx 2.5000e-04,7.5000e-04       # Lx/4 (big, warm) and 3Lx/4 (small, cold)
-ice_grain_cy 0.0,0.0                       # centres on the floor -> semicircles
-ice_grain_R  1.5e-4,5.0e-5                  # big LEFT (150 um), small RIGHT (50 um)
-ice_grain_ax 1.5e-4,5.0e-5
-ice_grain_ay 1.5e-4,5.0e-5

-Nx 1648                                   # ceil(sqrt(2)*Lx/eps)
-Ny 495
-Nz 1
-eps 8.5840e-07

-delt_t 1.0e-4
-periodic 0
