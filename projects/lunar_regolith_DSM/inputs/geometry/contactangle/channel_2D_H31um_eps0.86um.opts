# =============================================================================
# geometry/contactangle/channel_2D_H31um_eps0.86um.opts
#
# channel_2D_H125um_eps0.86um.opts scaled by 1/4 in every length, at the SAME
# eps and the same element size (0.605 um against 0.607 um). 155 x 52 nodes,
# 24k DoF against 382k: a cheap stand-in for local numerical tests such as the
# dtmax ladder. Not a production geometry.
#
# What changes with the scaling, and why it makes this the HARDER case for a
# timestep test rather than an equivalent one:
#   - meniscus curvature is 4x larger (chi = -3.2e4 1/m at theta = 60) and the
#     wall is 4x closer, so the interface moves ~5.7x faster (~270 nm/day at
#     alpha_c = 1e-3): about 40 steps per element at 0.8 tau_sub, not 180;
#   - the shape relaxes in ~2 days instead of ~30;
#   - eps/R_grain = 1/27 instead of 1/109, inside the 1/25-1/50 range the
#     angle sweep verified.
# So a dtmax that is clean here is clean on the 125 um channel; one that fails
# here may still be fine there.
#
# tau_sub is unchanged (it depends on eps and alpha_c, not on the domain).
# =============================================================================
-ic_type multi_grains
-dim 2
-Nx 155
-Ny 52
-Nz 1
-Lx 9.375e-5
-Ly 3.125e-5
-Lz 0

# One disc, centred, radius 0.75*Ly -> clipped by both walls, two contact lines.
-ice_grain_cx 4.6875e-5
-ice_grain_cy 1.5625e-5
-ice_grain_R  2.34375e-5

-eps 8.5840e-07
-eps_valid_temp -20.0
-delt_t 1.0e-4
-periodic 0
-wall_faces y0,y1

# Timestep ceiling. Lives here with eps (tau_sub goes as eps^2, so a shared
# experiment file cannot express it). tau_sub = 2.9743e+03 s with the
# thin-interface correction; dtmax = tau_sub/2 per the measured study in
# studies/contact_angle/verification/dtmax_study.{sh,csv}, which found theta_inf
# insensitive to dtmax over a 16x range.
-dtmax 1.487e3
