# Scripts wf_launch may run, one per line: <script under scripts/literature_review/> <profile in profiles/>
# Nothing else can be launched; arguments are fixed by wf_launch (the run ID), never free text.
# acquire.py and curator.py are not here: they run outside the sandbox and ask each time.
discover.py         api
resolve.py          api
screen_baseline.py  offline
compare_screens.py  offline
prepare.py          offline
build_index.py      offline
ocr_math.py         offline
check_extraction.py offline
check_units.py      offline
compare_sources.py  offline
compare_reads.py    offline
check_citations.py  offline
calibrate.py        offline
library_query.py    offline
audit.py            api
zotero_pull.py      zotero-local
zotero_add.py       zotero-web
drive_agents.py     anthropic
