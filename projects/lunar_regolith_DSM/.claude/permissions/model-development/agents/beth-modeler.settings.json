{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Edit",
      "Bash"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "NotebookEdit",
      "Skill"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${MD_HOOKS}/md_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${MD_HOOKS}/md_stop.py\"",
            "timeout": 320
          }
        ]
      }
    ]
  }
}
