{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "autoMemoryDirectory": "~/.claude/projects/lunar_regolith_DSM/memory",
  "permissions": {
    "ask": [
      "Bash(*scripts/Studio/run_*)",
      "Bash(*scripts/HPC/submit_*)",
      "Bash(sbatch *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(mpiexec *)",
      "Bash(mpirun *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(/library/papers/**)",
      "Read(/library/memos/**)",
      "Read(/library/history/**)",
      "Read(/library/views/**)",
      "Read(/library/.staging/**)",
      "Read(/library/events.jsonl)",
      "Read(/library/catalog.sqlite)",
      "Read(/library/references.bib)",
      "Read(/library_practice/**)",
      "Read(/index/**)",
      "Read(/runs/literature-review/**/untrusted/**)",
      "Read(//Users/jacksonbaglino/Library/Mobile Documents/com~apple~CloudDocs/Documents/Research/Projects/lunar_regolith_DSM/Literature/incoming/**)",
      "Edit(/library/**)",
      "Edit(/library_practice/**)",
      "Edit(/index/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_session.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
