{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "autoMemoryDirectory": "~/.claude/projects/lunar_regolith_DSM/memory",
  "permissions": {
    "ask": [
      "Bash(*scripts/Studio/run_*)",
      "Bash(*scripts/HPC/submit_*)",
      "Bash(sbatch *)",
      "Bash(git push *)",
      "Bash(*run_b1.py approve*)",
      "Bash(*run_b1.py freeze*)",
      "Bash(*run_b1.py thaw*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(mpiexec *)",
      "Bash(mpirun *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(/library/papers/**)",
      "Read(/library/memos/**)",
      "Read(/library/history/**)",
      "Read(/library/views/**)",
      "Read(/library/.staging/**)",
      "Read(/library/events.jsonl)",
      "Read(/library/catalog.sqlite)",
      "Read(/library/references.bib)",
      "Read(/library_practice/**)",
      "Read(/index/**)",
      "Read(/runs/literature-review/**/untrusted/**)",
      "Read(//Users/jacksonbaglino/Library/Mobile Documents/com~apple~CloudDocs/Documents/Research/Projects/lunar_regolith_DSM/Literature/incoming/**)",
      "Edit(/library/**)",
      "Edit(/library_practice/**)",
      "Edit(/index/**)"
    ],
    "allow": [
      "Bash(venv_workflows/bin/python scripts/literature_review/run_b1.py status*)",
      "Bash(venv_workflows/bin/python scripts/literature_review/run_b1.py run *)",
      "Bash(venv_workflows/bin/python scripts/literature_review/run_b1.py init *)",
      "Bash(venv_workflows/bin/python scripts/literature_review/run_b1.py verify)",
      "Bash(venv_workflows/bin/python scripts/literature_review/lr_status.py *)",
      "Bash(venv_workflows/bin/python scripts/literature_review/lr_backlog.py *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_session.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lr_session_status.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff_check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lr_prompt_status.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lr_phase_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lr_line_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lr_stop_check.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
