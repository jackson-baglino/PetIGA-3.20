{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "autoMemoryDirectory": "~/.claude/projects/lunar_regolith_DSM/memory",
  "permissions": {
    "ask": [
      "Bash(*scripts/Studio/run_*)",
      "Bash(*scripts/HPC/submit_*)",
      "Bash(sbatch *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(mpiexec *)",
      "Bash(mpirun *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_session.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
