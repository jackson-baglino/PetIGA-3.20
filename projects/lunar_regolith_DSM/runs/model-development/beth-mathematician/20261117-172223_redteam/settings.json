          {
            "type": "command",
            "command": "\"/Users/jacksonbaglino/PetIGA-3.20/projects/lunar_regolith_DSM/venv_workflows/bin/python\" \"/Users/jacksonbaglino/PetIGA-3.20/projects/lunar_regolith_DSM/scripts/agentkit/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/jacksonbaglino/PetIGA-3.20/projects/lunar_regolith_DSM/venv_workflows/bin/python\" \"/Users/jacksonbaglino/PetIGA-3.20/projects/lunar_regolith_DSM/scripts/agentkit/stop_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
