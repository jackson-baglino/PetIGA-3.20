# Experiment: T = -10 C   (generated by preprocess/generate_study_opts.py)
#
# Kinetics are temperature-specific. The solver rescales both of these by
# rho_vs(T)/rho_ice at runtime, but beta_HK's 1/sqrt(T) and d0's 1/T are baked
# in here -- do NOT reuse this file at another temperature.
#
#   alpha_c   = 1.0000e-03   (condensation coefficient; the one free parameter)
#   rho_vs    = 2.1392e-03 kg/m^3
#   rho_vs/rho_ice = 2.3277e-06

-temp -10
-humidity 1
-t_final 2.592e+06                  # 30 days

-beta_sub0 3.089991e+06       # K&P beta0 = beta_HK/(rho_vs/rho_i), UNSCALED
-d0_sub0 9.765924e-10         # physical gamma*V_m/(R*T), K&P Eq. 13 (NOT pre-scaled)

# Interface-CFL limiter: cap dt so no Gauss point moves more than dphimax per step
-dtCFL 1
-dtCFL_dphimax 0.2
-dtmax 3449                  # 1.09 * tau_sub (3164 s); a BACKSTOP -- -dtCFL is the control
