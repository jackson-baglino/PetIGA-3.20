# Geometry: phi0.400_seed1 at T = -20 C
# (generated by preprocess/generate_study_opts.py)
#
# Packing is temperature-independent; eps and the mesh are not. eps is sized by
# comp_eps.py with v_n derived self-consistently from R_feat = 2 um,
# so the K&P Eq. 45 kinetic bound equals R_feat and does not collapse at cold
# temperatures. Binding bound here: B-KINETIC.
#
#   porosity (achieved) = 0.4001   target 0.4000
#   grains              = 378
#   contact gap         = 4.00 um
#   coordination number = 2.40
#
# THROATS vs THE DIFFUSE BAND -- the binding constraint on eps for k_eff, and the
# one to check before trusting a conductivity from this geometry. Where the band
# is wider than a throat, phi never reaches 0 inside it, so ThermalCond returns
# well above k_air in a channel that ought to be air and k_eff reads HIGH.
#   pore throat  p25 =   4.00 um   p50 =  10.45 um
#   diffuse band 6*eps  =  12.00 um  (1.15x the median throat)
#                9.2*eps =  18.40 um  (1.76x)

-ic_type multi_grains_file
-grains_file inputs/packings/phi0.400_seed1/grains.dat
-ic_grain_union 1                 # phi=0.5 contour sits on the sharp geometry for any eps

-dim 2
-Lx 2.000000e-03
-Ly 2.000000e-03
-Nx 1415                          # ceil(sqrt(2)*Lx/eps)
-Ny 1415

-eps 2.000000e-06              # comp_eps.py @ T=-20C, safety=1
-eps_valid_temp -20                # solver ABORTS if -temp differs by >1C

-delt_t 0.0001
