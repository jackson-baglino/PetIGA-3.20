# =============================================================================
# geometry/2D_Tgrad_3grain_smallC.opts — three grains, SMALL centre grain.
# Temperature-gradient sanity series (Effort 1). Identical to
# 2D_Tgrad_3grain_equal.opts except the middle grain is halved.
# Pair with experiment/Tgrad_T-20_G50_3d.opts (dT/dx = -50 K/m, left warm).
#
# TEST 4 — small centre grain. Ostwald ripening drives the small (25 um) middle
# grain to SHRINK regardless of position; the gradient adds a directional bias
# (warm left -> cold right). Visualises how the two drivers combine on the
# most ripening-disadvantaged grain.
#
# GEOMETRY (planar 2D, NOT axisymmetric)
# --------------------------------------
#   Lx = 1.125e-3 m, Ly = 2.0e-4 m; centres 0.2/0.5/0.8 Lx, y = 0
#   R = 50, 25, 50 um  (centre grain halved)
#   NOTE: eps/R_centre = 3.4% (< 5% but near the resolution floor — bump the
#   centre to 30 um if the diffuse interface looks too fat on this grain).
#
# eps / MESH  (comp_eps.py, T0 = -20 C, alpha_c = 1.341e-2)
#     python preprocess/comp_eps.py --Lx 1.125e-3 --Ly 2.0e-4 --Rave 2.5e-5 \
#         --T0 -20 --alpha 1.341e-2
# =============================================================================

-axisym 0

-ic_type multi_grains
-dim 2
-Lx 1.1250e-03
-Ly 2.0000e-04
-Lz 0

-ice_grain_cx 2.2500e-04,5.6250e-04,9.0000e-04   # 0.2Lx, 0.5Lx, 0.8Lx
-ice_grain_cy 0.0,0.0,0.0                          # centres on the floor -> semicircles
-ice_grain_R  5.0e-5,2.5e-5,5.0e-5                  # SMALL centre (25 um)
-ice_grain_ax 5.0e-5,2.5e-5,5.0e-5
-ice_grain_ay 5.0e-5,2.5e-5,5.0e-5

-Nx 1854                                   # ceil(sqrt(2)*Lx/eps)
-Ny 330
-Nz 1
-eps 8.5840e-07

-delt_t 1.0e-4
-periodic 0
