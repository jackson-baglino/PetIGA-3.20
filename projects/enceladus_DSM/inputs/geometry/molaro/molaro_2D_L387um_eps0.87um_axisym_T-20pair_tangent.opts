# =============================================================================
# geometry/molaro/molaro_2D_L387um_eps0.87um_axisym_T-20pair_tangent.opts
#
# COARSE arm of the mesh-resolution pair. Identical to
# molaro_2D_L387um_eps0.24um_axisym_T-20pair_tangent.opts in every physical
# respect -- same grains, same tangent contact, same union IC -- and different
# only in eps and the mesh it implies.
# Pair with experiment/molaro/molaro_T-20_h1.00_79h_a1e-3_coarse.opts.
#
# WHAT THE PAIR IS FOR
# --------------------
# The fine arm resolves the neck across Molaro's measured range; this one does
# NOT. If both recover the same power law where they overlap, coarse meshes are
# good enough for the rest of the campaign and everything gets ~13x cheaper.
# If they disagree, the neck-visibility criterion is real and the fine mesh is
# mandatory. Either answer is worth 5 ranks.
#
#   arm      eps          Nx x Ny     nodes    neck floor (width)
#   coarse   8.6750e-07    631 x 198   125 k    60.1 um   <- this file
#   fine     2.4002e-07   2281 x 713  1.63 M    31.6 um
#
#   Molaro's measured neck spans 32.8 -> 64.8 um WIDTH, so the coarse arm only
#   becomes trustworthy near the very end of their range while the fine arm
#   covers essentially all of it.
#
# SIZED BY comp_eps, NOT BY PICKING A MESH
# ----------------------------------------
#   preprocess/comp_eps.py --Lx 3.87e-4 --Ly 1.21e-4 --Rave 8.675e-5 \
#       --T0 -20 --alpha 1e-3 --vn_feature 1.735e-06 --safety 0.5
#     BINDING: Eq.(45) d0/(beta_sub*vn) = 1.7350e-06 (= R_feat, beta-independent
#              under --vn_feature), so eps = 0.5 * R_feat
#     eps = 8.6750e-07, tau_sub = 5.9757e+03 s
#     tau_sub bracket 98.4% kinetic; thin-interface ratio 0.988 (heat),
#     0.995 (vapour); eps/R_ave = 1.0%
#
# Note the Eq. 42 ceilings are slack here: at alpha_c = 1e-3 the kinetic bound
# Eq. 45 is what binds, not the thermal or vapour channels.
#
# TWO RESOLUTION CRITERIA, AND THEY DISAGREE
# ------------------------------------------
# Eq. 45 is K&P's ASYMPTOTIC VALIDITY condition (eps <= R_feat) and is
# satisfied. Neck VISIBILITY is a separate, stricter, practical criterion --
# the fillet rho ~ r^2/(2R) must exceed the ~6*eps diffuse band to be measured
# at all -- and it is NOT satisfied over Molaro's range at this eps. That gap
# is exactly what this pair tests.
#
# REGIME: severely kinetics-limited, which is the point. L* = beta_HK*D_v =
# 139 um at alpha_c = 1e-3 and -20 C, against a neck radius of 30 um at the
# floor, so r/L* = 0.22. Kuczynski's t^(1/3) is derived in this regime.
#
# alpha_c is supplied POINTWISE by the paired experiment file
# (-alpha_pointwise 1), so -beta_sub0 plays no part; the solver prints a banner
# saying so.
#
# Measure with: python postprocess/neck_width.py <run_dir> --axisym
# Fit with:     python postprocess/fit_neck_growth.py <run>/neck_width.csv \
#                   inputs/validation/molaro2019_fig11_T-20.csv --demmenie
# =============================================================================

-axisym 1
-ic_grain_union 1                       # zero neck at tangency

-ic_type multi_grains
-dim 2
-Lx 3.87000e-04
-Ly 1.21000e-04
-Lz 0

-ice_grain_cx 9.25000e-05,2.66000e-04   # d = 1.735e-4 = R0+R1, EXACTLY TANGENT
-ice_grain_cy 0.0,0.0
-ice_grain_R  7.25e-5,1.01e-4
-ice_grain_ax 7.25e-5,1.01e-4
-ice_grain_ay 7.25e-5,1.01e-4

-Nx 631                                 # h = eps/sqrt(2)  (~125k nodes)
-Ny 198
-Nz 1
-eps 8.6750e-07
-eps_valid_temp -20

-delt_t 1.0e-4
-periodic 0
