# Geometry: phi0.250_seed1 at T = -5 C
# (generated by preprocess/generate_study_opts.py)
#
# Packing is temperature-independent; eps and the mesh are not. eps is sized by
# comp_eps.py with v_n derived self-consistently from R_feat = 2 um,
# so the K&P Eq. 45 kinetic bound equals R_feat and does not collapse at cold
# temperatures. Binding bound here: B-KINETIC.
#
#   porosity (achieved) = 0.2481   target 0.2500
#   grains              = 458
#   contact gap         = 4.00 um
#   coordination number = 3.52
#   diffuse band 6*eps  = 6.00 um   (compare with the throat sizes above)

-ic_type multi_grains_file
-grains_file inputs/packings/phi0.250_seed1/grains.dat
-ic_grain_union 1                 # phi=0.5 contour sits on the sharp geometry for any eps

-dim 2
-Lx 2.000000e-03
-Ly 2.000000e-03
-Nx 2829                          # ceil(sqrt(2)*Lx/eps)
-Ny 2829

-eps 1.000000e-06              # comp_eps.py @ T=-5C, safety=0.5
-eps_valid_temp -5                # solver ABORTS if -temp differs by >1C

-delt_t 0.0001
