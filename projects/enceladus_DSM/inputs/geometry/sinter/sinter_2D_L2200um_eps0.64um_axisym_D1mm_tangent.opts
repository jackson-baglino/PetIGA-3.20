# =============================================================================
# geometry/sinter/sinter_2D_L2200um_eps0.64um_axisym_D1mm_tangent.opts
#
# COARSE arm (comp_eps --safety 1.0) of the Demmenie et al. (2025) replication.
# Identical to sinter_2D_L2200um_eps0.32um_axisym_D1mm_tangent.opts in every
# respect except eps and the mesh it implies — read that file's header for the
# experiment, the geometry, the union-IC argument and the resolution floor.
# Pair with experiment/sinter/sinter_T-3_h1.00_2.5h_a9.0e-2.opts.
#
# THIS ARM HAS TWO JOBS
# ---------------------
# 1. PILOT. 19.6M dof against 78.5M, and tau_sub = 16.3 s against 3.0 s, so it
#    is ~20x cheaper (~220-450 core-h vs ~4800-9000) and answers the one
#    question that sizes the strict run: how far up in r/R0 does the neck
#    actually climb in 2.5 h? The strict arm's fit window does not open until
#    r/R0 = 0.087, so if this finishes below ~0.15 there is nothing to fit and
#    t_final must be raised before spending the production run.
#
# 2. eps CONVERGENCE. A 2x eps ratio against the strict arm. If the fitted
#    alpha agrees over the shared window, the exponent is not a discretisation
#    artifact. This has real teeth here because the resolution floor moves with
#    it: sqrt(12*eps/R) = 0.124 here versus 0.087 strict, so the two arms are
#    not even looking at the same part of the curve unless the exponent is
#    genuinely flat.
#
# IT IS DELIBERATELY LOOSE, AND THE RATE IS NOT TO BE QUOTED FROM IT
# -------------------------------------------------------------------
# comp_eps at --safety 1.0 reports a thin-interface correction beta_eff/beta
# of 0.209 on the binding heat channel (0.605 strict) and a kinetic fraction of
# tau_sub of 47.9%, just under the 50% that puts us in the sharp-interface
# regime. So this arm's neck GROWTH RATE is not trustworthy. Its EXPONENT
# plausibly is -- the committed Molaro eps series (0.35/0.60/0.86 um) has local
# log-slopes that collapse onto each other to within ~0.01 even though the
# absolute widths differ, which is the empirical basis for expecting the shape
# to be far less eps-sensitive than the rate.
#
# If the two arms disagree on alpha, do not split the difference: add the
# --safety 0.7 arm (eps 4.4486e-07, 6994 x 1908, tau_sub 6.75 s, ~1100 core-h,
# heat correction 0.407) and look at the trend in eps rather than at two points.
#
# MESH
# ----
# preprocess/comp_eps.py --Lx 2.2e-3 --Ly 6.0e-4 --Rave 5e-4 --T0 -3 \
#     --alpha 9.007e-2 --vn_feature 1e-5 --safety 1.0
#   BINDING bound: K&P Eq. 43a (heat channel, D*_ia * beta_HK = 6.3552e-07)
#   eps = 6.3552e-07 (= the bound itself at safety 1), tau_sub = 16.34 s
#   4896 x 1336 = 6.5M nodes = 19.6M dof; one sol_*.dat is ~157 MB
#
# Measure with: python postprocess/neck_width.py <run_dir> --axisym
# Fit with:     python postprocess/fit_neck_growth.py <run_dir>/neck_width.csv --demmenie
# =============================================================================

-axisym 1
-ic_grain_union 1                       # zero neck at tangency

-ic_type multi_grains
-dim 2
-Lx 2.2e-03
-Ly 6.0e-04
-Lz 0

-ice_grain_cx 6.0e-04,1.6e-03           # d = 1.0e-3 = R0+R1, EXACTLY TANGENT
-ice_grain_cy 0.0,0.0
-ice_grain_R  5.0e-04,5.0e-04
-ice_grain_ax 5.0e-04,5.0e-04
-ice_grain_ay 5.0e-04,5.0e-04

-Nx 4896                                # h = eps/sqrt(2)  (~6.5M nodes)
-Ny 1336
-Nz 1
-eps 6.3552e-07
-eps_valid_temp -3

-delt_t 1.0e-4
-periodic 0                             # zero-flux walls: sealed, mass-conserving
