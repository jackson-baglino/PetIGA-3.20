# =============================================================================
# experiment/base/base_T-20_h1.00_1d.opts — 1 day at -20°C, saturated humidity
#
# Air exactly at saturation (humidity = 1.0). No bulk sublimation driving
# force in the air; any kinetics come from curvature (Gibbs-Thomson) or
# explicit gradients. Typical of the 2D multi-grain tests where Ostwald
# ripening and sintering are the phenomena of interest.
# =============================================================================

# ---------- Simulation time ----------
# ---------------------------------------------------------------------------
# NO KINETICS SET IN THIS FILE. It leaves -beta_sub0 and -d0_sub0 at the code
# defaults, which are the -5 C-era values (d0_sub0 = 1e-7, beta_sub0 = 9.9e5)
# -- NOT the physical -20 C values. That is fine for a smoke test or a mesh/
# timestep probe, and wrong for any run whose physics you intend to believe.
# For -20 C physics use the sibling with an explicit alpha_c token, e.g.
# base_T-20_h1.00_30d_a1.34e-2.opts.
# ---------------------------------------------------------------------------
-t_final 86400.0                        # 1 day (s)

# ---------- Environmental conditions ----------
-temp -20.0                             # initial temperature [°C]
-humidity 1.00                          # initial relative humidity in air (saturated)
-grad_temp0 0.0,0.0,0.0                 # no imposed temperature gradient
