# Build artifacts
obj/
*.o
enceladus_dsm

# macOS metadata
.DS_Store
.DS_Store?
._*

# Python virtual environments
venv_*/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Simulation outputs (generated at runtime)
outputs/
scratch/

# Generated geometry previews (regenerable by preprocess/build_geometry_*.py)
preprocess/*.vtk

# Parameter-sweep run outputs (drivers/reports are tracked explicitly with -f)
test/tune_*/
test/plots/
# Stray SSA file written when a run is launched without -output_path
/SSA_evo.dat

# Editor/IDE files
.vscode/settings.json
*.swp
*.swo
*~

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Cached neck measurements (regenerable by plot_neck_convergence.py)
_neck_csv/

# k_eff verification: per-run scratch dirs (SSA_evo.dat etc). The .log files
# next to them ARE tracked -- they are the evidence behind the study README.
studies/snow_thermal/verification/raw/*/

# ...but the k_eff verification figures are documentation: the study README
# embeds them, so they are tracked despite the blanket *.png rule above.
!studies/snow_thermal/verification/*.png
